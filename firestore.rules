rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Reglas para la colección de usuarios
    match /usuarios/{userId} {
      // Cualquier usuario autenticado puede leer datos de usuarios
      allow read: if request.auth != null;

      // Un usuario puede crear o actualizar su propio registro al registrarse o iniciar sesión
      allow create, update: if request.auth != null && (
        request.auth.uid == userId ||
        (exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'superadmin')
      );

      // Solo superadmin puede eliminar usuarios
      allow delete: if request.auth != null &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'superadmin';
    }

    // Reglas generales para todas las demás colecciones (reservas, mesas, etc.)
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}

