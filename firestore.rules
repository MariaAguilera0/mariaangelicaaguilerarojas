rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Reglas para la colección de usuarios
    match /usuarios/{userId} {
      // Cualquier usuario autenticado puede leer datos de usuarios
      allow read: if request.auth != null;

      // Un usuario puede crear su propio documento al registrarse
      allow create: if request.auth != null && request.auth.uid == userId;

      // El usuario puede actualizar su propio perfil, o un superadmin puede actualizar roles
      allow update: if request.auth != null && (
        request.auth.uid == userId ||
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'superadmin'
      );

      // Solo superadmin puede eliminar usuarios
      allow delete: if request.auth != null &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'superadmin';
    }

    // Reglas generales para otras colecciones (reservas, mesas, etc.)
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
